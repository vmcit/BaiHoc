!**/src/main/**/target/
!**/src/test/**/target/

# Maven wrapper
.mvn/timing.properties
.mvn/jvm.config

# Kotlin
.kotlin/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# Spring Boot
*.log
logs/

# Application secrets (never commit)
application-local.properties
application-secret.properties
application-prod.properties
*.env

# ===========================
# FRONTEND - Node.js / React / Vite
# ===========================

# Dependencies
node_modules/
frontend/node_modules/

# Build output
dist/
frontend/dist/
build/
frontend/build/

# Vite cache
.vite/
frontend/.vite/

# Environment variables
.env
.env.local
.env.*.local
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Package manager locks (giữ lại 1 trong 2, bỏ comment nếu cần bỏ qua)
# package-lock.json
# yarn.lock

# npm/yarn debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

